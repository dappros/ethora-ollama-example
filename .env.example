# Values for ethora-backend/services/ai/ai-service/.env on the Ethora server.
# Copy these lines into that file, then restart the ai-service PM2 process.

AI_API_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_CHAT_MODEL=qwen2.5:3b-instruct
AI_EMBEDDING_MODEL=nomic-embed-text

# The embedding column in Postgres is vector(256). nomic-embed-text honours the
# `dimensions: 256` parameter the ai-service sends, so no schema change is needed.
